# Qwen is the only runtime model; there is no offline Demo mode.
DASHSCOPE_API_KEY=replace_me
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Medical business data backend. Keep sqlite for local synthetic tests.
# Change to oracle only after the Oracle repository and server are configured.
MEDICAL_DB_BACKEND=sqlite
SQLITE_MEDICAL_DB=.medical-agent-data/osteoporosis.sqlite

# Local authentication. Used only when auth.sqlite creates the initial users.
# Change this before the first startup; changing it later does not reset passwords.
MEDICAL_AGENT_INITIAL_PASSWORD=replace-with-a-strong-local-password

# Separate password for the initial local administrator account.
MEDICAL_AGENT_INITIAL_ADMIN_PASSWORD=replace-with-a-different-strong-admin-password

# Keep false for local http://127.0.0.1 development. Production HTTPS must use true.
MEDICAL_AGENT_COOKIE_SECURE=false
